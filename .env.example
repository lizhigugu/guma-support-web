NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 後台管理頁（只放在 Vercel / .env.local，不能加 NEXT_PUBLIC）
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# 版頭主視覺（選填）
# 建議填三尺寸：Desktop 1920x800 / Tablet 1280x720 / Mobile 1080x1350
NEXT_PUBLIC_HEADER_IMAGE_URL_DESKTOP=
NEXT_PUBLIC_HEADER_IMAGE_URL_TABLET=
NEXT_PUBLIC_HEADER_IMAGE_URL_MOBILE=
# 舊版單一圖（相容保留；若有三尺寸，優先使用上面三個）
NEXT_PUBLIC_HEADER_IMAGE_URL=

# 頁尾 Google 表單與社群連結（選填；留空則不顯示該連結或顯示提示）
NEXT_PUBLIC_GOOGLE_FORM_URL=
NEXT_PUBLIC_SOCIAL_THREADS_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_DISCORD_URL=
